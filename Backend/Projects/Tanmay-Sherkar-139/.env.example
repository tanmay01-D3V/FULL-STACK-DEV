# ---- Server ----
PORT=5001
NODE_ENV=development

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# ---- Firebase ----
# Option A (local): path to the service-account JSON, relative to the project root.
GOOGLE_APPLICATION_CREDENTIALS=library-secret.json
# Option B (Render/Heroku): paste the FULL contents of the service-account JSON here.
# When set, it takes precedence over the file path above.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...",...}

FIREBASE_PROJECT_ID=library-managment-app-c2a9e

# ---- Lending policy ----
BORROW_DURATION_DAYS=14