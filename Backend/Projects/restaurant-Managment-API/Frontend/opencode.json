{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      ".opencode/skills/anthropics-skills",
      ".opencode/skills/ui-ux-pro-max-skill",
      ".opencode/skills/taste-skill",
      ".opencode/skills/vercel-agent-skills",
      ".opencode/skills/gsap-skills",
      ".opencode/skills/claudedesignskills",
      ".opencode/skills/convex-agent-skills"
    ]
  },
  "mcp": {
    "shadcn-ui": {
      "type": "local",
      "command": ["npx", "-y", "@jpisnice/shadcn-ui-mcp-server"],
      "enabled": true
    },
    "21st-magic": {
      "type": "remote",
      "url": "https://21st.dev/api/mcp",
      "enabled": true,
      "headers": {
        "x-api-key": "YOUR_21ST_API_KEY"
      }
    }
  }
}
